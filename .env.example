# ==============================================================================
# VARIÁVEIS PÚBLICAS (Client-side — prefixo NEXT_PUBLIC_ obrigatório)
# ==============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-supabase-anon-key

# ==============================================================================
# SEGREDOS SERVER-ONLY (NUNCA expor com NEXT_PUBLIC_)
# ==============================================================================

# Supabase (uso exclusivo em Server Actions / Route Handlers administrativos)
SUPABASE_SERVICE_ROLE_KEY=sua-supabase-service-role-key

# IA — Google Gemini API (Free Tier)
GEMINI_API_KEY=sua-gemini-api-key

# E-mail Transacional — Piloto (Brevo Free Tier ou Gmail SMTP com App Password)
# Provedor abstraído atrás de EmailSender (sem exigir domínio pago no piloto)
EMAIL_PROVIDER=smtp
EMAIL_FROM="Output 1v2 <seu-email@gmail.com>"
ADMIN_ALERT_EMAIL=admin@exemplo.com

# Configuração SMTP (Brevo SMTP ou Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app

# Opcional: API key do provedor de e-mail (ex.: Brevo API ou Resend pós-domínio)
EMAIL_PROVIDER_API_KEY=

# Segurança de Rotas Internas / Cron (Health-check e Expurgo 30 dias)
CRON_SECRET=defina-um-token-secreto-forte
